{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/platform/**/*.ts",
    "server/**/*.ts"
  ]
}
