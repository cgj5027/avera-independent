# Backend-only template, loaded from .env.local by start:local.
AVERA_PORT=4175
AVERA_DATA_STORE=sqlite
AVERA_SQLITE_PATH=data/avera.sqlite
AVERA_FILES_PATH=data/files
AVERA_INTEGRATION_MODE=gateway
# Set your operator-controlled HTTPS gateway before enabling online services.
# AVERA_GATEWAY_URL=https://gateway.example.test
# Hosted storage alternative; provide its credentials through backend secrets.
# AVERA_DATA_STORE=postgres
# AVERA_DATABASE_URL=postgresql://localhost/avera
AVERA_SYNC_ENABLED=false

# Connected services: set credentials through your backend secret manager, never VITE_.
# AVERA_GATEWAY_TOKEN is a unique installation grant, supplied securely.
# AVERA_AUTH_EMAIL=true
# AVERA_VAULT_KEY_PATH=data/vault.key
# PostgreSQL requires AVERA_VAULT_KEY (32 random bytes, base64).
# For direct mode / gateway operators only:
# OPENAI_API_KEY, OPENAI_MODEL (default gpt-4.1-mini)
# PLAID_CLIENT_ID, PLAID_SECRET (Sandbox only)
# OPENWEBNINJA_API_KEY (optional LinkedIn source)
# RESEND_API_KEY, AVERA_EMAIL_FROM (verified sender)
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (auth-hosting backend)
# AVERA_GATEWAY_GRANTS_FILE (gateway server only; private JSON file)
# AVERA_PUBLIC_ORIGIN=https://your-avera.example
# See docs/CONNECTED_SERVICES.md for setup and provider validation.

# Geocodio: set on the gateway (or advanced direct-mode server), never VITE_.
GEOCODIO_API_KEY=

# Recovery: private local/application-server recovery (not VITE_ variables).
# Defaults follow the SQLite database directory, or data/ for PostgreSQL.
# AVERA_BACKUP_DIR=data/backups
# AVERA_BACKUP_KEY_PATH=data/backup.key
# Optional mounted separate drive; keep its key elsewhere.
# AVERA_BACKUP_COPY_DIR=/private/off-device/avera-backups
# AVERA_BACKUP_MAX_BYTES=536870912
# See docs/BACKUP_RECOVERY.md; headless gateway DB backups are operator-managed.

# MCP: optional read-only inbound MCP, separate from Ask Avera.
# Enable on the application server, never the headless integration gateway.
# AVERA_MCP_ENABLED=true
# Optional exact browser origins, comma-separated, no wildcard. Native clients need no Origin header.
# AVERA_MCP_ALLOWED_ORIGINS=https://your-client.example
# See docs/MCP.md. Local desktops default to disabled.
